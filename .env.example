# Copy to .env.local for local development. In production these are set in the
# Vercel project settings, never in a file.
#
# Every value here is server-side only. None of them may EVER be renamed to
# NEXT_PUBLIC_* — anything with that prefix is inlined into the browser bundle
# and is readable with view-source.

# --- Supabase (required) -----------------------------------------------------
# Project settings -> API. The service role key bypasses row level security, so
# it is a full-access credential. Never put it in client code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (required) -------------------------------------------------------
# The from address must be on a domain you have verified in Resend, or delivery
# silently lands in spam.
RESEND_API_KEY=
RESEND_FROM="Your Team <hello@yourdomain.com>"

# --- HubSpot (optional) ------------------------------------------------------
# Must be a PRIVATE APP token: Settings -> Integrations -> Private Apps.
#
# A personal access key will NOT work - that one is for the `hs` CLI, not the
# CRM API. Legacy `hapikey` API keys were sunset in 2022 and are disabled.
#
# Scopes:
#   crm.objects.contacts.write   required, to create/update the contact
#   crm.objects.contacts.read    so `pnpm run doctor` can verify the token
#   crm.schemas.contacts.read    so the doctor can check lead_magnet_source
#
# Leave blank and the system runs without CRM sync: leads still land in Supabase
# and still get their email.
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Optional ----------------------------------------------------------------
# Internal address that gets a plain notification on every new lead.
LEAD_NOTIFY_EMAIL=
# Salt for hashing submitter IPs. Any long random string. Falls back to the
# Supabase service key if unset, which works but couples two unrelated secrets.
LEAD_IP_HASH_SALT=
